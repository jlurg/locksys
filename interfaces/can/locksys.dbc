BA_DEF_ BO_ "LsE2eMaxDelta" INT 0 14;
BA_DEF_ BO_ "LsRxTimeoutMs" INT 0 65535;
BA_DEF_ SG_ "GenSigStartValue" INT -8388608 268435455;
