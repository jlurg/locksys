{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --force-if-includes*)",
      "Bash(git push * --force-if-includes*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git config *user.name*)",
      "Bash(git config *user.email*)",
      "Bash(git tag *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(tools/git/pr-merge.sh*)",
      "Bash(./tools/git/pr-merge.sh*)",
      "Bash(bash tools/git/pr-merge.sh*)",
      "Read(/hil/config/**/*.local.yaml)",
      "Read(/.env)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-ai-attribution.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git merge *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-ai-attribution.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git -C *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-ai-attribution.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git -c *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-ai-attribution.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-ai-attribution.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(gh api *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-ai-attribution.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
