#
# Common CGW configuration (LS-CGW-SAD-001 section 13.3). Variant files sdkconfig.defaults.dev and
# sdkconfig.defaults.release are layered on top through SDKCONFIG_DEFAULTS.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x11000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS and watchdogs (t_cgw_task_wdt_ms = 2000, t_cgw_int_wdt_ms = 300)
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TASK_WDT_TIMEOUT_S=2
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_INT_WDT_CHECK_CPU1=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Core dump to flash (ELF, SHA-256)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y

# Hardening and reproducibility
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
# CONFIG_APP_COMPILE_TIME_DATE is not set
# CONFIG_PM_ENABLE is not set
# CONFIG_SPIRAM is not set

# Wi-Fi SoftAP (WPA3-SAE, H2E and hunting-and-pecking)
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=y
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y

# lwIP: tcpip task on CPU0, no IPv6, DHCP offers without DNS option
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=3
# CONFIG_LWIP_DHCPS_ADD_DNS is not set
# CONFIG_LWIP_IPV6 is not set

# HTTP server with WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_URI_LEN=64
CONFIG_HTTPD_SERVER_EVENT_POST_TIMEOUT=50
# CONFIG_HTTPD_QUEUE_WORK_BLOCKING is not set

# Crypto: PSA HKDF; TWAI ISR usable while the flash cache is disabled
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_TWAI_ISR_CACHE_SAFE=y

CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
CONFIG_CGW_TRACE_PINS=y
