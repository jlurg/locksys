#
# Single source of toolchain, image and dependency pins (LS-PRC toolchains).
# Format: one KEY=VALUE per line; no quotes, no spaces, no variable expansion; lines starting
# with # are comments. CI reads it with: grep -E '^[A-Z][A-Z0-9_]*=' tools/versions.env
# Python package versions are locked in uv.lock; the values here must match the pyproject pins.

# System
LS_SYSTEM_VERSION=0.1.0-dev

# ESP-IDF (CGW)
ESP_IDF_VERSION=v5.5.5
ESP_IDF_IMAGE=espressif/idf:v5.5.5@sha256:a9231d0697ab8f7517cc072e93b7c83e04907bfbfba80b6440d7dbbf90665cf2

# IAR (DCU, Lab Host): exact build recorded on the Lab Host; 10.10.x only if the licence allows
IAR_EWARM_BASELINE=9.70
IAR_VISUAL_STATE_MIN=11.2.1

# Arm toolchain and CMSIS (DCU)
ARM_GCC=13.3.rel1
STM32CUBECLT=1.19.0
ARM_GCC_MAC_BIN=/opt/ST/STM32CubeCLT_1.19.0/GNU-tools-for-STM32/bin
CMSIS_CORE=5.9.0
CMSIS_DEVICE_F1=v4.3.5

# C unit tests and coverage
CEEDLING=1.1.9
CEEDLING_IMAGE=locksys/ceedling:1.1.9
GCOVR=8.6

# Python (uv workspace)
PYTHON=3.13
UV=0.12.23
CANTOOLS=44.1.0
PY_PROTOBUF=6.33.6
PYTHON_CAN=4.6.1
PYVISA=1.16.2
PYVISA_PY=0.8.1
LOGIC2_AUTOMATION=1.0.11
UDSONCAN=1.26.1
CAN_ISOTP=2.0.7
ESPTOOL_HIL=5.4.0

# Protocol Buffers: protoc matches the Python protobuf 6.33.x runtime
PROTOC=33.6
PROTOC_SHA256_LINUX_X86_64=9c49962391ff8b5754342509efc3885db91dfe11a358e1e98c9a71518f0ad199
PROTOC_SHA256_LINUX_AARCH_64=4016cd2ad24c6a2405332a2ef7e04b719240e40d811587c6a1c4bbe514cd668c
PROTOC_SHA256_OSX_AARCH_64=606aca137976af9090847025dcc8fc0daceb5cbbc5a46819296118fc53f0b870
PROTOC_SHA256_OSX_X86_64=13a2c245613ed7eca4a8c1a779545f0f2762f2735b2f7d7f7d6fe2618440ae2d
PROTOC_SHA256_WIN64=96a83b8ee942f1046f079c43657cc09fd41f37a4e349ddb0e8ba5064c48bb5ff
NANOPB=0.4.9.2
NANOPB_SRC_URL=https://github.com/nanopb/nanopb/releases/download/nanopb-0.4.9.2/nanopb-0.4.9.2.tar.gz
NANOPB_SRC_SHA256=98b8cadce538f37230ca0d5d8796894e3067d58dd2fb2618e6712c7362bdd8bb

# Flutter and Dart (APP): archive SHA-256 values from the Flutter release feeds
FLUTTER=3.47.6
DART=3.13.5
FLUTTER_SHA256_LINUX_X64=f1631b9c2c8b3529323db412b0d1beacf4a748f8783b0d7cf599a8fd5f461675
FLUTTER_SHA256_MACOS_ARM64=a1946d3b6b3de15ce247dc89649df9035ce29e6b4e7ebe91919a25890ea2e79a
FLUTTER_SHA256_MACOS_X64=f1f68c777b2b34153e1631670445efbeb218f42a398be32bba2051476719b0a4
FLUTTER_SHA256_WINDOWS_X64=a01bb0d26de91bc23c97cd9ccfaad281a612fb8304213fdd5df1119a09404796
DART_PROTOBUF=6.1.0
DART_PROTOC_PLUGIN=25.1.0

# Vendored C libraries (CGW)
QRCODEGEN=1.8.0

# Lint and release tooling (must match .pre-commit-config.yaml and the CI workflows)
ACTIONLINT=1.7.12
SHELLCHECK=0.11.0
PRE_COMMIT=4.6.2
CLANG_FORMAT=23.1.2
ZIZMOR=1.30.1
GIT_CLIFF=2.14.2
